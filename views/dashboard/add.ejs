<div class="container-fluid container-fluid-custom pb-5 mb-5">
    <div class="row">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/dashboard">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Add Note
                    </li>
                </ol>
            </nav>
            <div class="col">
                <div class="col d-flex justify-content-between align-items-center">
                    <h1 class="h3">Add Note</h1>
                </div>
            </div>
        </div>
    </div>

    <form action="/dashboard/add" method="POST" class="position-relative" id="addNoteForm">
        <div class="form-group mb-4" style="left: -1px; top: 1px; right: 1px;">
            <input required type="text" class="form-control fw-bold border-0 fs-4" name="title" id="title" placeholder="Title">
        </div>
        <div class="form-group mb-4">
            <textarea required rows="12" placeholder="Take a note..." class="form-control pt-3 fs-4" name="body" id="body"></textarea>
        </div>
        <div class="form-group">
            <button class="btn btn-primary btn-lg d-inline-flex align-items-center" type="submit" id="addBtn">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="addSpinner" role="status" aria-hidden="true"></span>
                <span id="addBtnText">+ Add Note</span>
            </button>
        </div>
    </form>

    <script>
        const addForm = document.getElementById('addNoteForm');
        const addBtn = document.getElementById('addBtn');
        const addSpinner = document.getElementById('addSpinner');
        const addBtnText = document.getElementById('addBtnText');

        addForm.addEventListener('submit', function(e) {
            if (addForm.dataset.submitting === 'true') {
                e.preventDefault();
                return;
            }
            if (addForm.checkValidity()) {
                addForm.dataset.submitting = 'true';
                addSpinner.classList.remove('d-none');
                addBtnText.textContent = 'Adding Note...';
                addBtn.classList.add('disabled');
                addBtn.style.pointerEvents = 'none';
                setTimeout(() => {
                    addBtn.disabled = true;
                }, 10);
            }
        });
    </script>
</div>