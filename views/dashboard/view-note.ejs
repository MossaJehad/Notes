<div class="container-fluid container-fluid-custom pb-5 mb-5">
    <div class="row">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/dashboard">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        <%= note.title %>
                    </li>
                </ol>
            </nav>
            <div class="col">
                <div class="col d-flex justify-content-between align-items-center">
                    <h1 class="h3">view Note</h1>
                    <button type="button" class="btn btn-danger me-2" data-bs-toggle="modal" id="deleteButton" data-bs-target="#deleteModal">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <form action="/dashboard/item/<%=noteID%>?_method=PUT" method="POST" class="position-relative" id="updateNoteForm">
        <div class="form-group mb-4" style="left: -1px; top: 1px; right: 1px;">
            <input required type="text" class="form-control fw-bold border-0 fs-4" name="title" id="title" value="<%= note.title %>" placeholder="Title">
        </div>
        <div class="form-group mb-4">
            <textarea required rows="12" placeholder="Take a note..." class="form-control pt-3 fs-4" name="body" id="body"><%=note.body%></textarea>
        </div>
        <div class="form-group">
            <button class="btn btn-primary btn-lg d-inline-flex align-items-center" type="submit" id="updateBtn">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="updateSpinner" role="status" aria-hidden="true"></span>
                <span id="updateBtnText">Update</span>
            </button>
        </div>
    </form>

</div>

<div class="modal fade" tabindex="-1" id="deleteModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">You are about to delete a note</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>This will delete your Note
            <b class="fw-bold"><%= note.title %></b>
            <br>
            <br>
            Are you sure?
          </p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <form action="/dashboard/item-delete/<%= noteID %>?_method=DELETE" method="POST" class="position-relative" id="deleteNoteForm">
            <button type="submit" class="btn btn-danger d-inline-flex align-items-center" id="deleteModalBtn">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="deleteSpinner" role="status" aria-hidden="true"></span>
                <span id="deleteBtnText">Delete</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

<script>
    const updateForm = document.getElementById('updateNoteForm');
    const updateBtn = document.getElementById('updateBtn');
    const updateSpinner = document.getElementById('updateSpinner');
    const updateBtnText = document.getElementById('updateBtnText');

    if (updateForm) {
        updateForm.addEventListener('submit', function(e) {
            if (updateForm.dataset.submitting === 'true') {
                e.preventDefault();
                return;
            }
            if (updateForm.checkValidity()) {
                updateForm.dataset.submitting = 'true';
                updateSpinner.classList.remove('d-none');
                updateBtnText.textContent = 'Updating...';
                updateBtn.classList.add('disabled');
                updateBtn.style.pointerEvents = 'none';
                setTimeout(() => {
                    updateBtn.disabled = true;
                }, 10);
            }
        });
    }

    const deleteForm = document.getElementById('deleteNoteForm');
    const deleteModalBtn = document.getElementById('deleteModalBtn');
    const deleteSpinner = document.getElementById('deleteSpinner');
    const deleteBtnText = document.getElementById('deleteBtnText');

    if (deleteForm) {
        deleteForm.addEventListener('submit', function(e) {
            if (deleteForm.dataset.submitting === 'true') {
                e.preventDefault();
                return;
            }
            deleteForm.dataset.submitting = 'true';
            deleteSpinner.classList.remove('d-none');
            deleteBtnText.textContent = 'Deleting...';
            deleteModalBtn.classList.add('disabled');
            deleteModalBtn.style.pointerEvents = 'none';
            setTimeout(() => {
                deleteModalBtn.disabled = true;
            }, 10);
        });
    }
</script>