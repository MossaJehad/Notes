<div class="container-fluid" bis_skin_checked="1">
    <header class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3 mb-4">
      <a href="/" class="d-flex align-items-center col-md-3 mb-2 mb-md-0 text-primary text-decoration-none fw-bold fs-2">
        Notes
      </a>

      <ul class="nav col-12 col-md-auto mb-2 justify-content-center mb-md-0">
        <li><a href="/" class="nav-link px-2 <%= (typeof currentRoute !== 'undefined' && currentRoute === '/') ? 'link-secondary' : 'link-dark' %>">Home</a></li>
        <li><a href="/features" class="nav-link px-2 <%= (typeof currentRoute !== 'undefined' && currentRoute === '/features') ? 'link-secondary' : 'link-dark' %>">Features</a></li>
        <li><a href="/faq" class="nav-link px-2 <%= (typeof currentRoute !== 'undefined' && (currentRoute === '/faq' || currentRoute === '/faqs')) ? 'link-secondary' : 'link-dark' %>">FAQs</a></li>
        <li><a href="/about" class="nav-link px-2 <%= (typeof currentRoute !== 'undefined' && currentRoute === '/about') ? 'link-secondary' : 'link-dark' %>">About</a></li>
        <% if (typeof user !== 'undefined' && user) { %>
          <li><a href="/dashboard" class="nav-link px-2 link-dark">Dashboard</a></li>
        <% } %>
      </ul>

      <div class="col-md-3 text-end" bis_skin_checked="1">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" type="button" class="btn btn-primary me-2">Dashboard</a>
          <a href="/logout" type="button" class="btn btn-outline-primary">Logout</a>
        <% } else { %>
          <a href="/auth/google" type="button" class="btn btn-outline-primary me-2">Login</a>
          <a href="/auth/google" type="button" class="btn btn-primary">Sign-up</a>
        <% } %>
      </div>
    </header>
    <script>
      (function() {
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll('header .nav-link').forEach(link => {
          const href = link.getAttribute('href');
          if (href === currentPath || (href === '/faq' && currentPath === '/faqs')) {
            link.classList.remove('link-dark');
            link.classList.add('link-secondary');
          } else if (href && href.startsWith('/')) {
            link.classList.remove('link-secondary');
            link.classList.add('link-dark');
          }
        });
      })();
    </script>
  </div>