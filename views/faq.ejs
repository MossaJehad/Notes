<div id="main">
    <div class="container py-4" style="max-width: 800px;">
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold mb-3">Frequently Asked Questions</h1>
            <p class="fs-5 text-muted">Got questions? We've got answers.</p>
        </div>

        <div class="accordion border-primary" id="faqAccordion">
            <div class="accordion-item bg-transparent border-primary mb-3 rounded">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button bg-transparent fw-bold text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        Is Notes free to use?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                    <div class="accordion-body fs-6">
                        Yes! Notes is completely free to use. You can create, edit, search, and manage as many notes as you want without any subscription or payment.
                    </div>
                </div>
            </div>

            <div class="accordion-item bg-transparent border-primary mb-3 rounded">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed bg-transparent fw-bold text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        How do I create an account?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                    <div class="accordion-body fs-6">
                        You don't need to fill out registration forms or remember passwords. Simply click the "Login" or "Sign-up" button and authenticate securely with your existing Google account.
                    </div>
                </div>
            </div>

            <div class="accordion-item bg-transparent border-primary mb-3 rounded">
                <h2 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed bg-transparent fw-bold text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        Are my notes private and secure?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                    <div class="accordion-body fs-6">
                        Yes. Each note is tied directly to your unique authenticated user account. Only you can view, edit, or delete notes that you have created.
                    </div>
                </div>
            </div>

            <div class="accordion-item bg-transparent border-primary mb-3 rounded">
                <h2 class="accordion-header" id="headingFour">
                    <button class="accordion-button collapsed bg-transparent fw-bold text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                        Can I access my notes from my phone?
                    </button>
                </h2>
                <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordion">
                    <div class="accordion-body fs-6">
                        Yes! Notes is fully responsive and optimized for mobile devices. Open your browser on any phone or tablet and sign in to access your notes anytime.
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5 pt-3">
            <p class="fs-5 mb-3">Ready to start taking notes?</p>
            <% if (typeof user !== 'undefined' && user) { %>
                <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
            <% } else { %>
                <a href="/auth/google" class="btn btn-primary btn-lg">Get Started Free</a>
            <% } %>
        </div>
    </div>
</div>
