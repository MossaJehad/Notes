<div id="main">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold mb-3">Features</h1>
            <p class="fs-5 text-muted">Everything you need to keep your thoughts organized and accessible.</p>
        </div>

        <div class="row g-4 py-2 row-cols-1 row-cols-md-2 row-cols-lg-3">
            <div class="col">
                <div class="card h-100 border-primary shadow-sm bg-transparent p-3">
                    <div class="card-body">
                        <div class="fs-1 mb-2">⚡</div>
                        <h4 class="card-title fw-bold">Fast & Simple</h4>
                        <p class="card-text fs-6">Jot down notes instantly with a clean, distraction-free interface built for speed.</p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-primary shadow-sm bg-transparent p-3">
                    <div class="card-body">
                        <div class="fs-1 mb-2">🔒</div>
                        <h4 class="card-title fw-bold">Google Authentication</h4>
                        <p class="card-text fs-6">Sign in seamlessly and securely with your Google account. No separate passwords to remember.</p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-primary shadow-sm bg-transparent p-3">
                    <div class="card-body">
                        <div class="fs-1 mb-2">☁️</div>
                        <h4 class="card-title fw-bold">Cloud Synced</h4>
                        <p class="card-text fs-6">All your notes are safely backed up and synchronized using MongoDB cloud storage.</p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-primary shadow-sm bg-transparent p-3">
                    <div class="card-body">
                        <div class="fs-1 mb-2">🔍</div>
                        <h4 class="card-title fw-bold">Instant Search</h4>
                        <p class="card-text fs-6">Quickly locate any note by keyword from your personal dashboard search bar.</p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-primary shadow-sm bg-transparent p-3">
                    <div class="card-body">
                        <div class="fs-1 mb-2">✏️</div>
                        <h4 class="card-title fw-bold">Full Note Management</h4>
                        <p class="card-text fs-6">Create, view, update, and delete notes effortlessly whenever your thoughts change.</p>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-primary shadow-sm bg-transparent p-3">
                    <div class="card-body">
                        <div class="fs-1 mb-2">📱</div>
                        <h4 class="card-title fw-bold">Fully Responsive</h4>
                        <p class="card-text fs-6">Designed to look great and work smoothly on smartphones, tablets, and desktop browsers.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5 pt-3">
            <% if (typeof user !== 'undefined' && user) { %>
                <a href="/dashboard" class="btn btn-primary btn-lg">Go to Dashboard</a>
            <% } else { %>
                <a href="/auth/google" class="btn btn-primary btn-lg">Try Notes Now</a>
            <% } %>
        </div>
    </div>
</div>
